generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProgramLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProgramGoal {
  STRENGTH
  HYPERTROPHY
  ENDURANCE
  FAT_LOSS
  GENERAL_FITNESS
}

enum ExerciseCategory {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  ABS
  CARDIO_MOBILITY
}

enum ExerciseMovementType {
  COMPOUND
  ISOLATION
  CARRY
  PLYOMETRIC
  ISOMETRIC
  CARDIO
  MOBILITY
  STRETCH
}

enum ExerciseObjective {
  STRENGTH
  MUSCLE_GAIN
  ENDURANCE
  FAT_LOSS
  POWER
  MOBILITY
  REHAB
  POSTURE
}

enum MediaType {
  IMAGE
  THUMBNAIL
  ANIMATION
}

enum MediaFormat {
  LOTTIE
  WEBP
  GIF
  MP4
  SVG
  JPG
  PNG
  OTHER
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum WatchSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum WatchActionReceiptStatus {
  IN_PROGRESS
  COMPLETED
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum IntegrationProvider {
  SPOTIFY
  HEALTH_CONNECT
  SAMSUNG_HEALTH
}

enum IntegrationStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
}

enum MetricType {
  BODY_WEIGHT
  BODY_FAT
  WAIST
  CHEST
  ARM
  THIGH
  PERFORMANCE
}

enum CoachWeeklyReportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AssistantProposalStatus {
  PROCESSED
}

enum CoachWeeklyReportFeedback {
  USEFUL
  NOT_USEFUL
}

enum ProgressPhotoView {
  FRONT
  SIDE
  BACK
  FREE
}

model UserProfile {
  id                            String                  @id @default(cuid())
  displayName                   String
  email                         String?                 @unique
  age                           Int?
  heightCm                      Int?
  weightKg                      Float?
  trainingLevel                 ProgramLevel?
  primaryGoal                   ProgramGoal?
  sessionsPerWeek               Int?
  stripeCustomerId              String?                 @unique
  stripeSubscriptionId          String?                 @unique
  googlePlayPurchaseTokenHash   String?                 @unique
  googlePlayOrderId             String?
  googlePlayProductId           String?
  googlePlayBasePlanId          String?
  googlePlayPackageName         String?
  subscriptionStatus            SubscriptionStatus      @default(FREE)
  subscriptionPriceId           String?
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionCancelAtPeriodEnd Boolean                 @default(false)
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  programs                      Program[]
  healthDevices                 HealthDevice[]
  integrationConnections        IntegrationConnection[]
  watchPairingTokens            WatchPairingToken[]
  watchDevices                  WatchDevice[]
  watchActionReceipts           WatchActionReceipt[]
  workoutSessions               WorkoutSession[]
  progressMetrics               ProgressMetric[]
  bodyMeasurements              BodyMeasurement[]
  progressPhotos                ProgressPhoto[]
  aiProgramGenerations          AiProgramGeneration[]
  coachWeeklyReports            CoachWeeklyReport[]
  assistantUnansweredQuestions  AssistantUnansweredQuestion[]
  assistantUsageWindows         AssistantUsageWindow[]

  @@index([subscriptionStatus])
}

model AiProgramGeneration {
  id            String      @id @default(cuid())
  userProfileId String
  periodKey     String
  goal          String
  level         String
  status        String
  createdAt     DateTime    @default(now())
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, periodKey, createdAt])
  @@index([periodKey, status])
}

model CoachWeeklyReport {
  id            String                    @id @default(cuid())
  userProfileId String
  periodKey     String
  periodStart   DateTime
  periodEnd     DateTime
  metrics       Json
  response      Json?
  model         String?
  status        CoachWeeklyReportStatus   @default(PENDING)
  errorCode     String?
  feedback      CoachWeeklyReportFeedback?
  generatedAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  userProfile   UserProfile               @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, periodKey])
  @@index([userProfileId, periodEnd])
  @@index([status, createdAt])
}

model KnowledgeArticle {
  id           String   @id @default(cuid())
  title        String
  category     String
  content      String
  keywords     String[] @default([])
  routeContext String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, routeContext])
  @@index([category, active])
}

model AssistantArticleProposalProgress {
  id          String                  @id @default(cuid())
  proposalId  String                  @unique
  status      AssistantProposalStatus @default(PROCESSED)
  articleId   String?                 @unique
  processedAt DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status, processedAt])
}

model AssistantUnansweredQuestion {
  id            String       @id @default(cuid())
  userProfileId String?
  question      String
  routeContext  String?
  createdAt     DateTime     @default(now())
  resolved      Boolean      @default(false)
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: SetNull)

  @@index([resolved, createdAt])
  @@index([userProfileId, createdAt])
}

model AssistantUsageWindow {
  id            String      @id @default(cuid())
  userProfileId String
  windowStart   DateTime
  requestCount  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, windowStart])
}

model BodyMeasurement {
  id                String      @id @default(cuid())
  userProfileId     String
  recordedAt        DateTime    @default(now())
  weightKg          Float?
  waistCm           Float?
  chestCm           Float?
  leftArmCm         Float?
  rightArmCm        Float?
  leftThighCm       Float?
  rightThighCm      Float?
  hipsCm            Float?
  leftCalfCm        Float?
  rightCalfCm       Float?
  fatMassKg         Float?
  bodyFatPercentage Float?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  userProfile       UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, recordedAt])
}

model ProgressPhoto {
  id            String            @id @default(cuid())
  userProfileId String
  recordedAt    DateTime          @default(now())
  view          ProgressPhotoView
  blobPath      String            @unique
  mimeType      String
  byteSize      Int
  width         Int?
  height        Int?
  createdAt     DateTime          @default(now())
  userProfile   UserProfile       @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, recordedAt])
  @@index([userProfileId, view, recordedAt])
}

model IntegrationConnection {
  id                String              @id @default(cuid())
  userProfileId     String
  provider          IntegrationProvider
  status            IntegrationStatus   @default(PENDING)
  externalAccountId String?
  displayName       String?
  scopes            String[]
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  metadata          Json?
  lastSyncAt        DateTime?
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  userProfile       UserProfile         @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, provider])
  @@index([provider, status])
  @@index([userProfileId, status])
}

model WatchDevice {
  id            String      @id @default(cuid())
  userProfileId String
  label         String
  tokenHash     String      @unique
  lastSeenAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, revokedAt])
  @@index([lastSeenAt])
}

model WatchPairingToken {
  id            String      @id @default(cuid())
  userProfileId String
  label         String
  tokenHash     String      @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model WatchActionReceipt {
  id            String                   @id @default(cuid())
  userProfileId String
  requestId     String
  operation     String
  payloadHash   String
  status        WatchActionReceiptStatus @default(IN_PROGRESS)
  httpStatus    Int?
  response      Json?
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  userProfile   UserProfile              @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, requestId, operation])
  @@index([userProfileId, status, updatedAt])
  @@index([status, createdAt])
}

model HealthDevice {
  id            String      @id @default(cuid())
  userProfileId String
  label         String
  tokenHash     String      @unique
  lastSeenAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, revokedAt])
  @@index([lastSeenAt])
}

model Exercise {
  id                    String               @id @default(cuid())
  slug                  String               @unique
  name                  String
  nameFr                String?
  category              ExerciseCategory
  movementType          ExerciseMovementType
  primaryMuscles        String[]
  primaryMusclesFr      String[]
  secondaryMuscles      String[]
  equipment             String[]
  equipmentFr           String[]
  difficulty            ProgramLevel
  objectives            ExerciseObjective[]
  shortTechnicalCues    String[]
  detailedInstructions  String
  instructionsFr        String?
  commonMistakes        String[]
  commonMistakesFr      String[]
  variants              String[]
  alternatives          String[]
  tags                  String[]
  contraindications     String[]
  primaryAnimationPath  String?
  fallbackImagePath     String
  fallbackThumbnailPath String
  fallbackAnimationPath String
  isCompound            Boolean              @default(false)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  media                 ExerciseMedia[]
  programExercises      ProgramExercise[]
  workoutSets           WorkoutSet[]

  @@index([category, difficulty])
  @@index([isActive])
  @@index([isActive, name])
  @@index([isActive, category, name])
  @@index([movementType])
}

model ExerciseMedia {
  id              String      @id @default(cuid())
  exerciseId      String
  type            MediaType
  format          MediaFormat
  storagePath     String
  publicUrl       String
  url             String?
  mimeType        String?
  width           Int?
  height          Int?
  durationSeconds Int?
  isLoop          Boolean     @default(false)
  sourceName      String?
  sourceUrl       String?
  license         String?
  isPrimary       Boolean     @default(false)
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  exercise        Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, type])
  @@index([exerciseId, sortOrder])
}

model Program {
  id              String           @id @default(cuid())
  userProfileId   String
  name            String
  goal            ProgramGoal
  level           ProgramLevel
  sessionsPerWeek Int
  description     String?
  status          ProgramStatus    @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userProfile     UserProfile      @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  days            ProgramDay[]
  workoutSessions WorkoutSession[]

  @@index([userProfileId, status])
}

model ProgramDay {
  id        String            @id @default(cuid())
  programId String
  dayIndex  Int
  title     String
  focus     String?
  createdAt DateTime          @default(now())
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]

  @@unique([programId, dayIndex])
  @@index([programId])
}

model ProgramExercise {
  id           String       @id @default(cuid())
  programDayId String
  exerciseId   String
  orderIndex   Int
  sets         Int
  repsMin      Int?
  repsMax      Int?
  repsText     String?
  restSeconds  Int          @default(60)
  tempo        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  programDay   ProgramDay   @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutSets  WorkoutSet[]

  @@unique([programDayId, orderIndex])
  @@index([exerciseId])
  @@index([programDayId, exerciseId])
}

model WorkoutSession {
  id              String        @id @default(cuid())
  userProfileId   String
  programId       String?
  programDayId    String?
  title           String
  status          SessionStatus @default(PLANNED)
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userProfile     UserProfile   @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  program         Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  sets            WorkoutSet[]
  watchSession    WatchSession?

  @@index([userProfileId, status, createdAt])
  @@index([userProfileId, status, endedAt, createdAt])
  @@index([userProfileId, programDayId, status])
}

model WatchSession {
  id                   String             @id @default(cuid())
  workoutSessionId     String             @unique
  currentExerciseIndex Int                @default(0)
  currentSetIndex      Int                @default(1)
  status               WatchSessionStatus @default(ACTIVE)
  lastSyncAt           DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workoutSession       WorkoutSession     @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@index([status, lastSyncAt])
}

model WorkoutSet {
  id                String           @id @default(cuid())
  workoutSessionId  String
  exerciseId        String
  programExerciseId String?
  setIndex          Int
  targetRepsMin     Int?
  targetRepsMax     Int?
  actualReps        Int?
  targetWeightKg    Float?
  actualWeightKg    Float?
  restSeconds       Int?
  rpe               Int?
  isCompleted       Boolean          @default(false)
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  workoutSession    WorkoutSession   @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise          Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  programExercise   ProgramExercise? @relation(fields: [programExerciseId], references: [id], onDelete: SetNull)

  @@index([workoutSessionId, setIndex])
  @@index([workoutSessionId, exerciseId, setIndex, createdAt])
  @@index([workoutSessionId, exerciseId, completedAt, createdAt])
  @@index([exerciseId])
  @@index([exerciseId, completedAt, createdAt])
}

model ProgressMetric {
  id            String      @id @default(cuid())
  userProfileId String
  metricType    MetricType
  value         Float
  unit          String
  measuredAt    DateTime    @default(now())
  notes         String?
  createdAt     DateTime    @default(now())
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, metricType, measuredAt])
}
