{
  "name": "traknio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "deploy:git": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/server/assistant/*.test.ts src/server/coach/*.test.ts src/server/progress-photos.test.ts src/server/watch-action-idempotency.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "media:add-gif": "tsx scripts/add-exercise-gif.ts",
    "media:add": "tsx scripts/add-exercise-media.ts",
    "reset:history-progress": "tsx scripts/reset-history-progress.ts",
    "import:exercises": "tsx prisma/import-exercises.ts --file=exercises.import.example.json",
    "import:free-exercise-db": "tsx prisma/import-free-exercise-db.ts",
    "translate:exercises-fr": "tsx scripts/translate-exercises-fr.ts",
    "standardize:exercises": "tsx scripts/standardize-exercises-table.ts",
    "report:missing-visuals": "tsx scripts/report-exercises-missing-visuals.ts",
    "fix:media-free-db": "tsx scripts/fix-exercise-media-from-free-db.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.7.0",
    "@vercel/oidc": "^3.8.2",
    "next": "16.2.5",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
