DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Optional comma-separated allowlist. Leave empty to allow any Google account.
TRAKNIO_ALLOWED_EMAILS=""
# Dedicated, server-only credentials used exclusively by Google Play review.
# Define both in the Vercel environment; never commit their real values.
TRAKNIO_REVIEWER_EMAIL="google-play-reviewer@example.com"
TRAKNIO_REVIEWER_PASSWORD="generate-a-long-unique-password"
# Optional comma-separated free premium access for owner/testers.
TRAKNIO_FREE_ACCESS_EMAILS=""

# Traknio Coach: enabled by default outside production. In production, it still
# requires the same premium entitlement as the rest of the application.
ENABLE_TRAKNIO_COACH="false"

# Contextual in-app help assistant. It follows the same premium access rules.
ENABLE_TRAKNIO_ASSISTANT="false"
TRAKNIO_ASSISTANT_MODEL="gpt-5-mini"
# Comma-separated emails allowed to manage the private assistant help center.
TRAKNIO_ADMIN_EMAILS=""

# Public app URL used by sitemap, robots.txt and metadata
NEXT_PUBLIC_SITE_URL="https://www.traknio.com"

# OpenAI program generation
OPENAI_API_KEY="sk-your-openai-api-key"

# Stripe subscriptions
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_MONTHLY_PRICE_ID="price_your-monthly-plan"
STRIPE_YEARLY_PRICE_ID="price_your-yearly-plan"
# Optional backward-compatible monthly fallback.
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# Google Play Billing for Android subscriptions.
GOOGLE_PLAY_PACKAGE_NAME="com.traknio.app"
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID="traknio_premium"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
# Or split service account credentials:
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Optional key for encrypting integration refresh/access tokens. Falls back to AUTH_SECRET if omitted.
INTEGRATION_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# Spotify OAuth
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_REDIRECT_URI="https://www.traknio.com/api/integrations/spotify/callback"

# Android Health sync uses per-account device tokens issued from the signed-in mobile app.
